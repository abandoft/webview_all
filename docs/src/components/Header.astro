---
import config from 'virtual:starlight/user-config';
import { getCollection } from 'astro:content';
import { docsVersions, documentationPath, documentHref, documentId, normalizedDocumentId } from '../versions';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
  config.pagefind ||
  config.components.Search !== '@astrojs/starlight/components/Search.astro';

const docsBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const { locale, version, slug } = documentationPath(Astro.url.pathname, docsBase);
const pages = new Set((await getCollection('docs')).map((entry) => normalizedDocumentId(entry.id)));
const options = docsVersions.map((target) => ({
  label: target,
  href: documentHref(docsBase, locale, target,
    pages.has(documentId(locale, target, slug)) ? slug : ''),
}));
const versionLabel = locale === 'zh' ? '文档版本' : 'Documentation version';
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
    <label class="version-picker print:hidden">
      <span class="sr-only">{versionLabel}</span>
      <select aria-label={versionLabel} data-docs-version>
        {options.map((option) => (
          <option value={option.href} selected={version === option.label}>{option.label}</option>
        ))}
      </select>
    </label>
  </div>
  <div class="sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<script>
  // Keep the button's announced state in sync with Starlight's menu element.
  const menu = document.querySelector('starlight-menu-button');
  const menuButton = menu?.querySelector('button');
  if (menu && menuButton) {
    const syncExpanded = () => menuButton.setAttribute('aria-expanded', menu.getAttribute('aria-expanded') ?? 'false');
    new MutationObserver(syncExpanded).observe(menu, {
      attributes: true,
      attributeFilter: ['aria-expanded'],
    });
    syncExpanded();
  }

  document.querySelectorAll('[data-docs-version]').forEach((element) => {
    if (element instanceof HTMLSelectElement) {
      element.addEventListener('change', () => {
        window.location.assign(element.value);
      });
    }
  });
</script>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      gap: var(--sl-nav-gap);
      justify-content: space-between;
      align-items: center;
      height: 100%;
    }

    .title-wrapper {
      align-items: center;
      gap: 0.65rem;
      overflow: clip;
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
    }

    .version-picker {
      flex: none;
    }

    .version-picker select {
      max-width: 8.5rem;
      min-height: 2.45rem;
      border: 1px solid var(--doc-line);
      border-radius: 999px;
      padding: 0.3rem 1.7rem 0.3rem 0.55rem;
      color: var(--sl-color-text);
      background-color: var(--doc-control);
      box-shadow: 0 1px 0 var(--doc-highlight) inset;
      font: inherit;
      font-size: var(--sl-text-xs);
    }

    .right-group,
    .social-icons {
      gap: 1rem;
      align-items: center;
    }

    .social-icons::after {
      content: '';
      height: 2rem;
      border-inline-end: 1px solid var(--sl-color-gray-5);
    }

    @media (max-width: 30rem) {
      .version-picker select {
        min-width: 5.4rem;
        max-width: 6rem;
        padding-inline: 0.6rem;
      }
    }

    @media (min-width: 50rem) {
      :global(:root[data-has-sidebar]) {
        --__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
      }

      :global(:root:not([data-has-toc])) {
        --__toc-width: 0rem;
      }

      .header {
        --__sidebar-width: max(
          0rem,
          var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x)
        );
        --__main-column-fr: calc(
          (
              100% + var(--__sidebar-pad, 0rem) -
                var(--__toc-width, var(--sl-sidebar-width)) -
                (2 * var(--__toc-width, var(--sl-nav-pad-x))) -
                var(--sl-content-inline-start, 0rem) - var(--sl-content-width)
            ) /
            2
        );
        display: grid;
        grid-template-columns:
          minmax(
            calc(
              var(--__sidebar-width) +
                max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))
            ),
            auto
          )
          1fr
          auto;
        align-content: center;
      }
    }
  }
</style>
